SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Set JWT_MODE to 'asymmetric' if your project uses asymmetric signing (most new projects),
# or 'symmetric' for legacy HS256 projects.
# Check: Supabase Dashboard > Project Settings > API > JWT Settings
JWT_MODE=asymmetric

# Only needed for JWT_MODE=symmetric:
# SUPABASE_JWT_SECRET=your_jwt_secret

# Google Drive OAuth (Milestone 5B)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/drive/callback

# Fernet key for encrypting Drive refresh tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your_fernet_key

# Flask
FLASK_SECRET_KEY=your_flask_secret_key
FLASK_ENV=development

# Frontend (used by index.html / JS — only ANON key goes to browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
